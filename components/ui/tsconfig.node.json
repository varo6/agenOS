{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "src/electron/**/*.ts",
    "../network/types.ts",
    "../network/node/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
