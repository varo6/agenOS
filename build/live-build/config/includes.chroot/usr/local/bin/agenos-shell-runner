#!/bin/sh
set -eu

INSTALLER_APP="/usr/local/bin/agenos-installer-app"
SYSTEM_APP="/usr/local/bin/agenos-system-app"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agenos-installer"
MODE_FILE="${RUNTIME_DIR}/shell-mode"
SESSION_HELPER_LOG="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/agenos-session-helpers.log"

start_session_helpers() {
  if command -v mako >/dev/null 2>&1; then
    mako >>"${SESSION_HELPER_LOG}" 2>&1 &
  fi

  if command -v agenos-battery-monitor >/dev/null 2>&1; then
    agenos-battery-monitor >>"${SESSION_HELPER_LOG}" 2>&1 &
  fi

  if command -v agenos-output-autoscale >/dev/null 2>&1; then
    agenos-output-autoscale >>"${SESSION_HELPER_LOG}" 2>&1 &
  fi

  # Despues de mako: el aviso de "sin persistencia" se manda por notificacion y
  # necesita que el demonio ya este escuchando.
  if command -v agenos-persistence-notice >/dev/null 2>&1; then
    agenos-persistence-notice >>"${SESSION_HELPER_LOG}" 2>&1 &
  fi
}

is_live_session() {
  if [ -e /run/live/medium ]; then
    return 0
  fi

  if grep -Eq 'boot=live|components' /proc/cmdline 2>/dev/null; then
    return 0
  fi

  return 1
}

resolve_mode() {
  if [ -f "${MODE_FILE}" ]; then
    mode="$(tr -d '\n\r' < "${MODE_FILE}" 2>/dev/null || true)"
    if [ "${mode}" = "installer" ] || [ "${mode}" = "system" ]; then
      printf '%s\n' "${mode}"
      return 0
    fi
  fi

  if is_live_session; then
    printf '%s\n' "system"
  else
    printf '%s\n' "system"
  fi
}

launch_installer() {
  swaymsg workspace "1:home" >/dev/null 2>&1 || true
  "${INSTALLER_APP}"
}

launch_system() {
  swaymsg workspace "1:home" >/dev/null 2>&1 || true
  "${SYSTEM_APP}"
}

start_session_helpers

while true; do
  mode="$(resolve_mode)"
  if [ "${mode}" = "system" ]; then
    launch_system
  else
    launch_installer
  fi
  sleep 1
done
