#!/bin/sh
set -eu

mkdir -p /etc/greetd /etc/agenos /etc/systemd/system/graphical.target.wants /etc/systemd/system/multi-user.target.wants

cat >/etc/greetd/config.toml <<'EOF'
[terminal]
vt = 7
switch = true

[default_session]
command = "/usr/sbin/agreety --cmd /bin/sh"
user = "_greetd"

[initial_session]
command = "sh /usr/local/bin/agenos-session"
user = "agenos"
EOF

cat >/etc/agenos/shell.json <<'EOF'
{
  "schemaVersion": 1,
  "bootMode": "installer",
  "startupAppDesktopId": null,
  "maintenanceEnabled": true
}
EOF

install -d -m 0755 /etc/sudoers.d
cat >/etc/sudoers.d/90-agenos-live <<'EOF'
agenos ALL=(ALL) NOPASSWD:ALL
EOF
chmod 0440 /etc/sudoers.d/90-agenos-live

install -d -o agenos -g agenos -m 0755 /home/agenos/Documentos
install -d -o agenos -g agenos -m 0755 /home/agenos/Fotos
install -d -o agenos -g agenos -m 0755 /home/agenos/Musica
install -d -o agenos -g agenos -m 0755 /home/agenos/Trabajo
install -d -o agenos -g agenos -m 0700 /home/agenos/.config
cat >/home/agenos/.config/user-dirs.dirs <<'EOF'
XDG_DESKTOP_DIR="$HOME/Trabajo"
XDG_DOCUMENTS_DIR="$HOME/Documentos"
XDG_DOWNLOAD_DIR="$HOME/Documentos"
XDG_MUSIC_DIR="$HOME/Musica"
XDG_PICTURES_DIR="$HOME/Fotos"
XDG_PUBLICSHARE_DIR="$HOME/Documentos"
XDG_TEMPLATES_DIR="$HOME/Documentos"
XDG_VIDEOS_DIR="$HOME/Fotos"
EOF
chown agenos:agenos /home/agenos/.config/user-dirs.dirs
chmod 0600 /home/agenos/.config/user-dirs.dirs

install -d -o agenos -g agenos -m 0700 /home/agenos/.agenos
install -d -o agenos -g agenos -m 0700 /home/agenos/.agenos/ui-dev
install -d -o agenos -g agenos -m 0700 /home/agenos/.agenos/ui-dev/pi
install -d -o agenos -g agenos -m 0700 /home/agenos/.agenos/openclaw
install -d -o agenos -g agenos -m 0700 /home/agenos/.agenos/memory
install -d -o agenos -g agenos -m 0700 /home/agenos/.agenos/broker
chown -R agenos:agenos /home/agenos/.agenos
chmod 0700 /home/agenos/.agenos

ln -sf /lib/systemd/system/greetd.service /etc/systemd/system/display-manager.service
ln -sf /lib/systemd/system/greetd.service /etc/systemd/system/graphical.target.wants/greetd.service
ln -sf /lib/systemd/system/seatd.service /etc/systemd/system/multi-user.target.wants/seatd.service
ln -sf /etc/systemd/system/agenos-agent-api.service /etc/systemd/system/graphical.target.wants/agenos-agent-api.service
ln -sf /etc/systemd/system/agenos-openclaw.service /etc/systemd/system/graphical.target.wants/agenos-openclaw.service
rm -f /etc/systemd/system/graphical.target.wants/lightdm.service
