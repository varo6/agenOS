[Unit]
Description=AgenOS Background Agent Worker
Wants=agenos-agent-api.service

[Service]
Type=simple
User=agenos
Group=agenos
Environment=HOME=/home/agenos
Environment=AGENOS_OPENCLAW_SYSTEM_CONFIG=/etc/agenos/openclaw.json
Environment=AGENOS_OPENCLAW_USER_CONFIG=/home/agenos/.agenos/openclaw/config.json
Environment=AGENOS_OPENCLAW_STATE_DIR=/home/agenos/.agenos/openclaw
Environment=AGENOS_WORKER_TOKEN_PATH=/home/agenos/.agenos/broker/worker-token
WorkingDirectory=/home/agenos
ExecStartPre=/usr/local/bin/agenos-openclaw-setup
ExecStart=/usr/local/bin/agenos-openclaw-worker
Restart=on-failure
RestartSec=3
Nice=10
CPUWeight=20
IOWeight=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/agenos/.agenos/openclaw /home/agenos/.agenos/memory /home/agenos/.agenos/broker

[Install]
WantedBy=graphical.target
