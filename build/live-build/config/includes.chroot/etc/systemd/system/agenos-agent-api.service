[Unit]
Description=AgenOS Agent Broker API
After=dbus.service

[Service]
Type=simple
User=agenos
Group=agenos
Environment=HOME=/home/agenos
Environment=AGENOS_OPENCLAW_SYSTEM_CONFIG=/etc/agenos/openclaw.json
Environment=AGENOS_OPENCLAW_USER_CONFIG=/home/agenos/.agenos/openclaw/config.json
Environment=AGENOS_OPENCLAW_STATE_DIR=/home/agenos/.agenos/openclaw
Environment=AGENOS_WORKER_TOKEN_PATH=/home/agenos/.agenos/broker/worker-token
# El control de escritorio del agente habla con ydotoold por este socket.
Environment=YDOTOOL_SOCKET=/run/ydotoold/socket
WorkingDirectory=/home/agenos
ExecStart=/usr/local/bin/agenos-installer-server
Restart=on-failure
RestartSec=3
# El broker abre ventanas del usuario (Chromium sobre todo). Con el KillMode por
# defecto, control-group, cada reinicio de esta unidad -- el de Restart= o el que
# hace agenos-resume-health al despertar -- mataria tambien esas ventanas y con
# ellas las sesiones web abiertas. El lanzador grafico ya mete cada ventana en su
# propio scope de systemd; esto cubre el caso en que no haya gestor de usuario.
KillMode=process

[Install]
WantedBy=graphical.target
