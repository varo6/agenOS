[Unit]
Description=AgenOS Agent Broker API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agenos
Group=agenos
Environment=HOME=/home/agenos
WorkingDirectory=/home/agenos
ExecStart=/usr/local/bin/agenos-installer-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical.target
