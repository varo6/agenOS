set $mod Mod4

xwayland enable
default_border none
default_floating_border none
focus_follows_mouse no
mouse_warping none
workspace_auto_back_and_forth no

input * {
  xkb_layout es
  xkb_model pc105
}

# Touchpad de portatil: mas especifico que "input *", que solo fija el teclado.
input type:touchpad {
  tap enabled
  natural_scroll enabled
  dwt enabled
  scroll_method two_finger
}

# Tema y tamaño explícitos: una instalación mínima no debe depender del cursor
# implícito que el toolkit o el visor de la VM decidan proporcionar.
seat * xcursor_theme Adwaita 24

output * bg #14100d solid_color

# Una sola barra permanente. Waybar actua como renderizador del bloque de Sway:
# mantiene los escritorios a la izquierda, centra el reloj contra la pantalla y
# deja el estado del workspace a la derecha. No hay una segunda superficie.
#
# swaybar_command tiene que ser un unico ejecutable SIN argumentos: Sway 1.7 lo
# lanza con execvp() usando la cadena entera como argv[0], asi que cualquier
# "-c ..." aqui hace que el exec falle en silencio y el escritorio arranque sin
# barra. Los argumentos de waybar viven dentro de /usr/local/bin/agenos-bar.
bar {
  position top
  mode dock
  swaybar_command /usr/local/bin/agenos-bar
}

# Los workspaces en sway se crean bajo demanda; un "workspace N" suelto aqui
# cambiaria el workspace activo durante el arranque y dejaria la pantalla en
# un workspace vacio (color solido). Solo fijamos el inicial.
workspace 1:home

# Las apps van maximizadas pero NO en fullscreen: el fullscreen de Sway tapa la
# swaybar y con ella el unico indicador de escritorio que tiene el usuario. Una
# ventana en tiling ya ocupa todo el area util del workspace (borde 0), asi que
# se ve igual de grande y la numeracion de arriba sigue presente.
#
# El routing de las apps que abre Pi lo decide agenos-graphical-launcher, que
# espera a que la ventana mapee y despues la mueve y enfoca. Aqui ya no hay
# reglas de Chromium: dos autoridades compitiendo por el mismo foco era una de
# las causas de que el navegador apareciera en el workspace equivocado.
#
# Foot conserva routing declarativo porque el atajo Ctrl+Alt+Return no pasa por
# el launcher. Va sin "focus" para no disputarselo, y solo matchea el app_id por
# defecto: las terminales que abre Pi usan --app-id=agenos-terminal.
for_window [app_id="^foot$"] move to workspace "5:work"
for_window [app_id="^(agenos-installer|agenos-installer-ui|com\\.agenos\\.installer)$"] move to workspace "1:home"
for_window [title="AgenOS Installer"] move to workspace "1:home"
for_window [app_id="^(electron|Electron|agenos-system-ui)$"] move to workspace "1:home"
for_window [title="^AgenOS$"] move to workspace "1:home"
for_window [title="^AgenOS Live System$"] move to workspace "1:home"

bindsym Ctrl+Alt+1 workspace 1:home
bindsym Ctrl+Alt+2 workspace 2:app
bindsym Ctrl+Alt+3 workspace 3:web
bindsym Ctrl+Alt+4 workspace 4:media
bindsym Ctrl+Alt+5 workspace 5:work
bindsym Ctrl+Alt+Return exec /usr/local/bin/agenos-shell-helper terminal
bindsym Ctrl+Alt+r exec /usr/local/bin/agenos-shell-helper reload-shell

# Teclas de portatil. --locked las mantiene vivas si mas adelante hay un locker.
# XF86Sleep se deja sin enlazar a proposito: logind ya la consume a nivel de
# sistema y un segundo handler pediria suspender dos veces.
bindsym --locked XF86MonBrightnessDown exec brightnessctl --quiet set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl --quiet set +5%
bindsym --locked XF86KbdBrightnessDown exec brightnessctl --quiet --device='*::kbd_backlight' set 10%-
bindsym --locked XF86KbdBrightnessUp exec brightnessctl --quiet --device='*::kbd_backlight' set +10%

bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle

bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioStop exec playerctl stop

# Energia: ciclo de perfil y estado de bateria hablado por notificacion.
bindsym --locked $mod+p exec /usr/local/bin/agenos-power-profile-cycle
bindsym --locked $mod+b exec /usr/local/bin/agenos-power-status --notify

# Solo una suscripcion por sesion; exec_always duplicaba el watcher en cada reload.
exec --no-startup-id /usr/local/bin/agenos-workspace-watch
exec_always --no-startup-id sh /usr/local/bin/agenos-shell-runner
